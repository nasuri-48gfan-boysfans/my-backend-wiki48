# ============================================================
# Salin berkas ini menjadi .env (untuk pengaturan umum) dan
# .env.local (untuk kredensial mesin sendiri).
#
# Urutan baca: .env  →  .env.local  →  variabel lingkungan asli.
# Yang belakangan menang. Di Vercel, dashboard selalu menang atas
# kedua berkas ini.
#
# JANGAN pernah commit .env atau .env.local — keduanya sudah ada
# di .gitignore. Berkas INI (.env.example) aman karena hanya berisi
# contoh, bukan nilai sungguhan.
# ============================================================

# ---------- Database (komunitas: login, komentar, profil) ----------
DATABASE_URL=postgresql://postgres:password@localhost:5432/wiki48
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
SESSION_SECRET=replace-with-a-long-random-string
ACCESS_REVIEW_TOKEN=replace-with-a-separate-admin-review-token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=generate-with-bcrypt
PORT=3000
# Domain frontend yang boleh akses API (CORS). Pisahkan dengan koma
# kalau lebih dari satu, mis. Vercel + custom domain.
FRONTEND_URL=https://namaproject.vercel.app
# Legacy (masih didukung): FRONTEND_ORIGIN=
NODE_ENV=development

# ============================================================
# LIVE TRACKER
# ============================================================

# ---------- Penyimpanan snapshot ----------
# Pilih SALAH SATU. Kalau dua-duanya terisi, Upstash yang dipakai
# (REST tidak butuh koneksi menetap, jadi itu yang cocok di Vercel).
#
# 1) Upstash (WAJIB untuk Vercel/serverless).
#    Ambil dari dashboard Upstash → tab "REST API".
#    Token REST panjangnya puluhan karakter; kalau yang kamu tempel
#    hanya 8-10 karakter, itu bukan token REST-nya.
UPSTASH_REDIS_REST_URL="https://contoh-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="tempel-token-rest-upstash-di-sini"
#    Integrasi Upstash/KV bawaan Vercel memakai nama lain; keduanya
#    dikenali otomatis, jadi tidak perlu disalin ulang:
#    KV_REST_API_URL / KV_REST_API_TOKEN
#
# 2) Redis TCP biasa (localhost / Redis Cloud / Railway).
#    Punya pub/sub, jadi update SSE tanpa jeda. Tidak bisa dipakai
#    dari Vercel kalau alamatnya localhost.
REDIS_URL=redis://localhost:6379

# Umur snapshot di Redis. Harus lebih besar dari jarak antar siklus,
# kalau tidak statusnya sempat hilang sebelum siklus berikutnya menulis.
LIVE_SNAPSHOT_TTL_SECONDS=600

# ---------- Irama polling ----------
LIVE_TRACKER_INTERVAL_MS=60000
LIVE_TRACKER_DELAY_MS=3500
# Jeda khusus IDN (dicek per member, jadi paling rawan kena rate limit).
LIVE_IDN_DELAY_MS=3500
# Berapa lama entri live ditahan saat provider sedang error, supaya satu
# kegagalan jaringan tidak mengosongkan banner live.
LIVE_HOLD_MS=300000
# Ambang "kedaluwarsa" untuk /api/live. 0 = otomatis (3x interval).
LIVE_STALE_MS=0

# ---------- Mode cron (Vercel) ----------
# Anggaran waktu satu invocation cron. HARUS lebih kecil dari
# maxDuration di vercel.json, kalau tidak fungsinya dibunuh sebelum
# snapshot ditulis dan seluruh siklus terbuang.
LIVE_CRON_BUDGET_MS=45000
# Wajib diisi di produksi: tanpa ini endpoint cron dimatikan, karena
# endpoint terbuka bisa dipakai siapa pun untuk membebani Showroom/IDN
# atas nama situs ini dan menghabiskan kuota Upstash.
# Bikin dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Worker in-process. Di serverless otomatis mati (loop 60 detik tidak
# akan pernah sampai siklus kedua). Kosongkan kecuali sedang men-debug.
LIVE_WORKER_INPROCESS=
# SSE. Otomatis mati di serverless; frontend jatuh ke polling.
LIVE_SSE=
# Port health check untuk `npm run live` di host always-on.
LIVE_HEALTH_PORT=

# ---------- Cache CDN (penjaga kuota Upstash) ----------
# Klien polling tiap 15 detik. Tanpa cache CDN, satu tab yang dibiarkan
# terbuka sehari bisa menghabiskan kuota gratis Upstash sendirian.
# Nilainya harus LEBIH KECIL dari jarak antar siklus cron, kalau tidak
# snapshot baru tidak pernah terlihat. 0 = matikan cache.
LIVE_CDN_S_MAXAGE=20
LIVE_CDN_SWR=60

# ---------- Jadwal stage resmi (/api/schedule) ----------
# Umur cache memori untuk satu grup+bulan (default 5 menit). Situs resmi
# tidak boleh diterjang setiap kunjungan halaman.
SCHEDULE_CACHE_TTL_MS=300000
# Batas waktu satu pengambilan data dari situs resmi (default 12 detik).
SCHEDULE_FETCH_TIMEOUT_MS=12000

# ---------- Notifikasi Discord ----------
# Boleh beberapa webhook: pisahkan dengan koma dalam satu baris,
# atau pakai DISCORD_WEBHOOK_URL_2, _3, dst.
# JANGAN menulis DISCORD_WEBHOOK_URL beberapa kali di baris berbeda —
# dotenv hanya menyimpan baris terakhir, sisanya hilang tanpa peringatan.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_2=
# Alternatif eksplisit; jika kosong, tiga webhook di atas dipetakan berurutan:
# pertama SHOWROOM, kedua IDN, ketiga YouTube.
DISCORD_SHOWROOM_WEBHOOK_URL=https://discord.com/api/webhooks/ID_WEBHOOK/TOKEN_WEBHOOK
DISCORD_IDN_WEBHOOK_URL=https://discord.com/api/webhooks/ID_WEBHOOK/TOKEN_WEBHOOK
DISCORD_YOUTUBE_WEBHOOK_URL=https://discord.com/api/webhooks/ID_WEBHOOK/TOKEN_WEBHOOK
DISCORD_USERNAME=WIKI48 Live
DISCORD_TIMEOUT_MS=8000
# Berapa lama satu siaran dianggap "sudah dikabarkan". Penanda ini yang
# mencegah notifikasi berulang tiap 2 menit di mode cron.
DISCORD_DEDUPE_TTL_SECONDS=21600
# Zona waktu untuk jam mulai di notifikasi.
LIVE_TIMEZONE=Asia/Jakarta

# ---------- Kredensial platform ----------
# YouTube search memakan 100 unit kuota per panggilan (harian 10.000),
# jadi anggarannya default 0 dan harus dinyalakan sadar.
YOUTUBE_API_KEY=
LIVE_YOUTUBE_BUDGET=0
SHOWROOM_AUTH_TOKEN=
IDN_AUTH_TOKEN=
# URL Cloudflare Worker yang mengambil data SHOWROOM untuk seluruh 48G.
SHOWROOM_ONLIVES_API_URL=https://workers-showroom-48wiki.wiki48workers.dev/

# Menulis balik room_id/url_key hasil temuan ke members.json.
# Di Vercel filesystem-nya read-only, jadi otomatis dilewati.
LIVE_TRACKER_PERSIST=true
