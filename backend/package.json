{
  "name": "wiki48-backend",
  "version": "1.0.0",
  "private": true,
  "description": "WIKI48 backend — Express API, live tracker worker, jadwal resmi",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch server/community-server.js",
    "live": "node server/live-runner.js",
    "worker": "node server/live-runner.js",
    "live:once": "node server/live-runner.js --once",
    "cek:live": "node data/tools/cek-live.js",
    "uji": "npm run uji:live && npm run uji:discord && npm run uji:cron && npm run uji:endpoint && npm run uji:kartu && npm run uji:yt && npm run audit",
    "uji:live": "node data/live-tracker/mock-test.js",
    "uji:discord": "node data/live-tracker/uji-discord.js",
    "uji:cron": "node data/live-tracker/uji-cron.js",
    "uji:endpoint": "node data/live-tracker/uji-endpoint.js",
    "uji:kartu": "node data/live-tracker/uji-kartu-live.js",
    "uji:yt": "node test/youtube-webhook.test.js",
    "audit": "node data/tools/audit.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^3.0.2",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "redis": "^5.0.1"
  }
}
