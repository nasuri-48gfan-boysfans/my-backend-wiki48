# =============================================================
#  FRONTEND (Vercel) — environment variables
#  Isi di: Vercel Dashboard → Project → Settings → Environment Variables
# =============================================================

# WAJIB. URL backend Railway TANPA trailing slash.
# Semua request /api/* di Vercel diteruskan ke sini oleh
# frontend/api/[...path].js (pola proxy).
BACKEND_URL=https://wiki48-backend-production.up.railway.app

# Wajib jika Vercel Cron masih dipakai untuk memicu /api/cron/update-live.
# Harus NILAINYA SAMA dengan CRON_SECRET di Railway (yang memvalidasi).
CRON_SECRET=

# Opsional — hanya jika memakai Supabase Storage/Auth langsung dari
# fungsi frontend (saat ini tidak dipakai; arsitektur proxy ke Railway).
SUPABASE_URL=
SUPABASE_KEY=
